# Copy to .env and enter your own Organizer code; no real credential is included.
# An empty code disables Organizer. Do not commit or share your .env.
ARENA_ADMIN_CODE=
# Account-only requires both flags. Keep origins exact (scheme + host + port).
# HTTP is a local/LAN QA exception; production HTTPS remains Phase 4.3.
ARENA_ACCOUNT_AUTH=0
ARENA_ACCOUNT_ONLY=0
# OFF by default. Requires Account-Only, schema v6 migrated OFFLINE.
# Local/LAN functional pilot only; not an Internet go-live switch.
ARENA_SELF_REGISTRATION=0
# Admin TOTP verification (requires offline provisioning for each Admin).
# Off in local migration QA; require ON before any publicly reachable Admin login.
ARENA_ADMIN_TOTP_REQUIRED=0
ARENA_AUTH_ORIGINS=
ARENA_AUTH_ALLOW_HTTP=0

# Generate privately: python -c "import secrets; print(secrets.token_hex(32))"
# Required by sandbox Compose. Never commit the generated value.
ARENA_RUNNER_TOKEN=
DOCKER_SOCKET_GID=0
SANDBOX_NAMESPACE=neon-arena

# Bind the host port on all interfaces for trusted LAN, or 127.0.0.1 for local only.
ARENA_BIND_IP=0.0.0.0
ARENA_PORT=8000

# Keep LAN demo mode. Public/named-host deployments require read-only mode.
ARENA_READ_ONLY=0
ARENA_ALLOWED_HOSTS=

# Public Gateway config is opt-in and only usable with the private
# reverse proxy in compose.public.yaml. Never expose the app port directly.
# A named Internet domain requires independent QA and deployment approval.
ARENA_PUBLIC_GATEWAY=0
ARENA_PUBLIC_DOMAIN=
# Generate privately: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER commit or print the real value into logs.
ARENA_PROXY_SECRET=

# To enable verified Player signup, configure the organization SMTP provider
# and test real delivery before setting ARENA_SELF_REGISTRATION=1.
ARENA_EMAIL_VERIFICATION=0
ARENA_SMTP_HOST=
ARENA_SMTP_PORT=587
ARENA_SMTP_USER=
ARENA_SMTP_PASSWORD=
ARENA_SMTP_FROM=
