# syntax=docker/dockerfile:1
FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends g++ openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 bot && useradd --uid 10001 --gid bot --no-create-home bot
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8
WORKDIR /work
COPY sandbox_controller/transfer.py /opt/arena-transfer.py
USER 10001:10001
CMD ["python", "-c", "import time; time.sleep(86400)"]
