# Example only: place map in nginx's http block and replace domain/certificate paths.
# This configuration exposes a READ-ONLY viewer. Do not enable public bot execution.
map $http_upgrade $arena_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name arena.example.com;
    return 301 https://arena.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name arena.example.com;
    ssl_certificate /etc/letsencrypt/live/arena.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/arena.example.com/privkey.pem;
    client_max_body_size 1m;

    # Extra proxy guard: spectators need GET/HEAD. Backend also enforces read-only.
    location / {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $arena_connection_upgrade;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
