# Copy to .env and enter your own Organizer code; no real credential is included.
# An empty code disables Organizer. Do not commit or share your .env.
ARENA_ADMIN_CODE=
# Account-only requires both flags. Keep origins exact (scheme + host + port).
# HTTP is a local/LAN QA exception; production HTTPS remains Phase 4.3.
ARENA_ACCOUNT_AUTH=0
ARENA_ACCOUNT_ONLY=0
# OFF by default. Requires Account-Only, schema v6 migrated OFFLINE.
# Local/LAN functional pilot only; not an Internet go-live switch.
ARENA_SELF_REGISTRATION=0
ARENA_AUTH_ORIGINS=
ARENA_AUTH_ALLOW_HTTP=0

# Generate privately: python -c "import secrets; print(secrets.token_hex(32))"
# Required by sandbox Compose. Never commit the generated value.
ARENA_RUNNER_TOKEN=
DOCKER_SOCKET_GID=0
SANDBOX_NAMESPACE=neon-arena

# Bind the host port on all interfaces for trusted LAN, or 127.0.0.1 for local only.
ARENA_BIND_IP=0.0.0.0
ARENA_PORT=8000

# Keep LAN demo mode. Public/named-host deployments require read-only mode.
ARENA_READ_ONLY=0
ARENA_ALLOWED_HOSTS=
