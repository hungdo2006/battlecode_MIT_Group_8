# Private authenticated reverse proxy. No forwarded client headers are trusted.
# Public DNS/certificate provision and AWS network changes are a LATER stage.
{$ARENA_PUBLIC_DOMAIN} {
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy arena:8000 {
        # Strip ALL user-supplied forwarded/identity headers before proving
        # that this is the selected HTTPS edge.
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Proto
        header_up -X-Forwarded-Host
        header_up -Forwarded
        header_up -X-Real-IP
        header_up Host {host}
        header_up X-Arena-Proxy-Secret {$ARENA_PROXY_SECRET}
        header_up X-Arena-Client-IP {remote_host}
        header_up X-Arena-HTTPS 1
    }
}
